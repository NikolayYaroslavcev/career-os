# Database
DATABASE_URL=postgresql://careeros:careeros_dev@localhost:5432/careeros

# Redis
REDIS_URL=redis://localhost:6379
# Password used by the Redis container (docker-compose). Only needed when
# REDIS_URL includes auth or when running Redis with --requirepass.
REDIS_PASSWORD=

# MinIO (provisioned by docker-compose but not yet wired to any feature —
# resume uploads currently write to local disk / the backend_uploads volume,
# see apps/backend/src/services/resume-service.ts)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=careeros
MINIO_USE_SSL=false

# Mailpit / SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
# Only needed against a real SMTP server (Mailpit accepts any/no auth locally).
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=CareerOS <noreply@careeros.local>

# Auth
JWT_SECRET=change-this-to-a-secure-random-string

# Encryption
# Master key for encrypting provider API keys at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required for production. Without it, the application will fail to start.
MASTER_ENCRYPTION_KEY=
# Set to "true" ONLY for local development when you cannot provide a master key.
# NEVER enable this in production. Default: false.
ALLOW_UNENCRYPTED_PROVIDER_KEYS=false
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Argon2 password hashing cost. Defaults are tuned for local dev; leave unset
# unless you have a specific reason to change them.
ARGON2_MEMORY_COST=
ARGON2_TIME_COST=
ARGON2_PARALLELISM=

# AI (optional for now)
# When false, the backend skips AI matching and the vacancy-analysis queue
# entirely — search returns persisted vacancies immediately with no scores.
# Useful for local development, UI testing, and provider debugging.
AI_ENABLED=true
AI_PROVIDER=openai
# Overrides the selected provider's default model. Only applies to AI_PROVIDER
# itself — fallback providers below use their own defaults (model IDs aren't
# portable across vendors, e.g. OpenRouter needs "anthropic/claude-...").
AI_MODEL=
# Overrides the 60s default every provider otherwise falls back to.
AI_TIMEOUT_MS=
# Ordered, comma-separated fallback chain tried on a retryable failure of
# AI_PROVIDER, e.g. "openrouter,openai". Empty/unset = no fallback.
AI_FALLBACK_PROVIDERS=
# Caps concurrent in-flight AI completion calls. Empty/unset = unlimited.
AI_MAX_CONCURRENCY=
# How many triage-ranked vacancies get an AI call per search profile per batch.
AI_MAX_CANDIDATES=
# Local triage-score floor a vacancy must clear to be eligible for an AI call
# at all, independent of the topN cut above (default 2).
AI_MIN_TRIAGE_SCORE=
# Fan-out for concurrent AI calls within a batch.
AI_MATCHING_CONCURRENCY=
# Size of each auto-continuation batch once a batch finishes processing.
AI_BATCH_SIZE=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
# Cheaper/faster Groq model used for low-stakes suggestions (e.g. search
# profile suggestion), kept separate from the vacancy matching model.
GROQ_SUGGESTION_MODEL=llama-3.1-8b-instant

# Telegram (optional for now)
TELEGRAM_BOT_TOKEN=
# Only needed if you switch the bot from long-polling to a webhook; unused otherwise.
TELEGRAM_WEBHOOK_URL=

# Job providers (all optional — a provider is registered only when its
# required identifiers below are set).
# HH (HeadHunter) uses a single API endpoint — api.hh.ru/vacancies — for
# every HH-group country; there is no separate provider/host per country.
# Countries are selected purely by area ID via the `area` query param, sent
# once per configured ID (api.hh.ru ORs repeated `area` params together).
# It needs no config at all and is always registered. An access token only
# raises rate limits.
# HH_AREAS: comma-separated HH area IDs to sync. Defaults to CIS + diaspora
# coverage: 113 = Russia, 16 = Belarus (via api.hh.ru, NOT rabota.by — it has
# no API), 40 = Kazakhstan, 97 = Uzbekistan, 48 = Kyrgyzstan, 9 = Azerbaijan,
# 28 = Georgia, 13 = Armenia, 86 = Tajikistan, 62 = Moldova.
#   Full list: https://api.hh.ru/areas — country-only list: https://api.hh.ru/areas/countries
# Ukraine (area 5) is deliberately excluded — HH's Ukraine operation was
# sold/rebranded years before 2022; do not add without a separate live check.
# NOTE: as of this writing api.hh.ru/vacancies returns HTTP 403 (DDoS-Guard
# bot-protection) from most cloud/datacenter IPs regardless of area — the
# provider is registered but its live status is BLOCKED until run from an
# unblocked IP or with a working proxy. See ADR-030 / hh-fetcher.ts.
HH_AREAS=113,16,40,97,48,9,28,13,86,62
HH_ACCESS_TOKEN=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
# Free self-service OAuth2 registration at https://francetravail.io (Emploi
# Store Développeurs). Optional ROME code filter defaults to M1805 (Études
# et développement informatique) if left blank.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_ROME_CODES=
# Defaults to JetBrains (job-boards.eu.greenhouse.io/jetbrains, live-verified)
# when left blank — set both to point at a different company's board instead.
GREENHOUSE_BOARD_TOKEN=
GREENHOUSE_COMPANY_NAME=
LEVER_COMPANY=
LEVER_COMPANY_NAME=
ASHBY_JOB_BOARD_NAME=
ASHBY_COMPANY_NAME=
WORKDAY_TENANT=
WORKDAY_SITE=
WORKDAY_COMPANY_NAME=
WORKDAY_HOST=
TEAMTAILOR_API_KEY=
TEAMTAILOR_COMPANY_NAME=
SMARTRECRUITERS_COMPANY=
SMARTRECRUITERS_COMPANY_NAME=
RECRUITEE_COMPANY=
RECRUITEE_COMPANY_NAME=
COMEET_TOKEN=
COMEET_COMPANY_UID=
COMEET_COMPANY_NAME=
# Personio — public, unauthenticated per-tenant XML feed
# (https://{company}.jobs.personio.de/xml). Unlike Greenhouse, no default
# tenant is set here — pick a real Personio-hosted company's subdomain.
PERSONIO_COMPANY=
PERSONIO_COMPANY_NAME=
PERSONIO_LANGUAGE=
# Workable — public, unauthenticated per-tenant JSON widget endpoint
# (https://apply.workable.com/api/v1/widget/accounts/{accountSlug}).
WORKABLE_ACCOUNT_SLUG=
WORKABLE_COMPANY_NAME=
# LinkedIn provider (Guest API, no auth needed) is registered by default.
# Set to "false" to disable it.
LINKEDIN_ENABLED=
# SuperJob — requires an X-Api-App-Id secret key for every endpoint, including
# plain vacancy search (there is no unauthenticated mode, unlike HH). Get one
# for free at https://api.superjob.ru/register/ (create account, create app,
# key issued instantly — no OAuth needed for read-only search). NOTE: as of
# this writing the registration page itself returns HTTP 403 from some
# datacenter/cloud IPs (SuperJob's edge WAF) — provision the key from an
# unblocked (e.g. residential/RU) IP if registration is refused.
SUPERJOB_API_KEY=
# Telegram public vacancy channels — comma-separated bare usernames, no
# `@`/`t.me/` prefix. Scraped via each channel's public `/s/` preview page
# (https://t.me/s/<username>), no bot token or login required. Unset =
# provider not registered. This is a fallback only — the TelegramChannel DB
# table (managed via /providers/telegram/channels) takes priority once
# populated; see apps/backend/src/scripts/manage-telegram-channels.ts.
# `golangjob` was removed 2026-07-31: reachable but stale, no new posts since
# 2023-02-10 (see apps/backend/src/scripts/investigate-telegram-channels.ts).
TELEGRAM_CHANNELS=remoteit,jobforjunior,geekjobs,workitkz,Relocats,job_python,datasciencejobs,fordevops,jobforqa,rabotafrontend,forfrontend,remotegeekjob,findwork,YotolabQA,forproducts,foranalysts,dev_connectablejobs,devs_it,myitjob,devops_jobs_feed,job_javadevs,job_react,fordesigner,junior_designers,forruby,godevjob

# Vacancy search / matching pipeline (all optional — sensible defaults apply)
PROVIDER_SEARCH_LIMIT=
PROVIDER_TIMEOUT_MS=
MIN_RELEVANCE_SCORE=
# BullMQ vacancy-analysis worker concurrency (apps/worker).
WORKER_CONCURRENCY=
# Gates the /api/v1/diagnostics/* routes and the dashboard diagnostics page.
# Leave false/unset in production.
DIAGNOSTICS_ENABLED=

# AI Orchestrator (optional — new subsystem for cost optimization)
# Mode: manual (default) | smart | automatic
AI_ORCHESTRATOR_MODE=manual
# Cache TTL in milliseconds (default: 24h)
AI_CACHE_TTL_MS=86400000
# Enable budget enforcement (default: true)
AI_BUDGET_CHECK_ENABLED=true
# Per-feature provider overrides (JSON format)
# AI_FEATURE_PROVIDER_MAP={"cover_letter":"openai","tailor_resume":"anthropic"}

# App
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3001
# apps/worker's own HTTP health server (it has no other HTTP interface).
WORKER_HEALTH_PORT=3002
