# Database
DATABASE_URL=postgresql://careeros:careeros_dev@localhost:5432/careeros

# Redis
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=careeros

# Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=CareerOS <noreply@careeros.local>

# Auth
JWT_SECRET=change-this-to-a-secure-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI (optional for now)
AI_PROVIDER=openai
# Overrides the selected provider's default model. Only applies to AI_PROVIDER
# itself — fallback providers below use their own defaults (model IDs aren't
# portable across vendors, e.g. OpenRouter needs "anthropic/claude-...").
AI_MODEL=
# Overrides the 60s default every provider otherwise falls back to.
AI_TIMEOUT_MS=
# Ordered, comma-separated fallback chain tried on a retryable failure of
# AI_PROVIDER, e.g. "openrouter,openai". Empty/unset = no fallback.
AI_FALLBACK_PROVIDERS=
# Caps concurrent in-flight AI completion calls. Empty/unset = unlimited.
AI_MAX_CONCURRENCY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Cheaper/faster Groq model used for low-stakes suggestions (e.g. search
# profile suggestion), kept separate from the vacancy matching model.
GROQ_SUGGESTION_MODEL=llama-3.1-8b-instant

# Telegram (optional for now)
TELEGRAM_BOT_TOKEN=

# Job providers (all optional — a provider is registered only when its
# required identifiers below are set)
GREENHOUSE_BOARD_TOKEN=
GREENHOUSE_COMPANY_NAME=
LEVER_COMPANY=
LEVER_COMPANY_NAME=
ASHBY_JOB_BOARD_NAME=
ASHBY_COMPANY_NAME=
WORKDAY_TENANT=
WORKDAY_SITE=
WORKDAY_COMPANY_NAME=
WORKDAY_HOST=
TEAMTAILOR_API_KEY=
TEAMTAILOR_COMPANY_NAME=

# App
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3001
